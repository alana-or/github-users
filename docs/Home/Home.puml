@startuml
actor User

participant "Home Component\n(Home.tsx)" as Home
participant "Next.js Server\n(getStaticProps)" as Server
participant "GitHub API" as GitHubAPI

User -> Server : Request Home Page
Server -> GitHubAPI : GET /users
alt Success
    GitHubAPI -> Server : Return List of Users
    Server -> GitHubAPI : GET /users/:username (for each user)
    GitHubAPI -> Server : Return User Details (for each user)
    Server -> Home : Return Static Props
else Error
    GitHubAPI -> Server : Error Response
    Server -> Home : Return Error Message
end

Home -> User : Render Home Page
alt Error
    Home -> User : Display "Falha ao carregar os usuários."
end
@enduml
